rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Full profile edits stay owner-only. A completed-project review also needs to
      // update the reviewed professional's aggregate rating and portfolio-preview stats —
      // those are narrow, system-computed fields, so any authenticated user may touch
      // *only* this specific field set, never the rest of the profile.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['rating', 'ratingCount', 'portfolioPreview', 'portfolioCount', 'updatedAt']
        )
      );
      allow delete: if false;
      match /portfolio/{itemId} {
        allow read: if true;
        allow create: if request.auth != null && (
          request.auth.uid == userId ||
          (
            request.resource.data.source == 'collaboration' &&
            request.resource.data.projectId is string &&
            request.auth.uid == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.homeownerUid &&
            userId == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.contractorUid
          )
        );
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.homeownerUid ||
        request.auth.uid == resource.data.contractorUid ||
        request.auth.uid == resource.data.pendingInvitationUid
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.homeownerUid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.homeownerUid ||
        request.auth.uid == resource.data.contractorUid ||
        request.auth.uid == resource.data.pendingInvitationUid
      );
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
        );
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid;
        allow update: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
        );
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid &&
          resource.data.hasProgress == false;
      }

      match /updates/{updateId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
        );
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid;
        allow update: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid;
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.recipientUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }
  }
}