rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['rating', 'ratingCount', 'portfolioPreview', 'portfolioCount', 'updatedAt']
        )
      );
      allow delete: if false;
      match /portfolio/{itemId} {
        allow read: if true;
        allow create: if request.auth != null && (
          request.auth.uid == userId ||
          (
            request.resource.data.source == 'collaboration' &&
            request.resource.data.projectId is string &&
            request.auth.uid == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.homeownerUid &&
            userId == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.contractorUid
          )
        );
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId && resource.data.source != 'collaboration';
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if resource.data.status == 'completed' || (
        request.auth != null && (
          request.auth.uid == resource.data.homeownerUid ||
          request.auth.uid == resource.data.contractorUid ||
          request.auth.uid == resource.data.pendingInvitationUid
        )
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.homeownerUid;
      allow update: if request.auth != null && (
        // Homeowner: edit project details — only while no invite is out yet.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['name', 'description', 'location', 'plannedStartDate', 'plannedEndDate', 'referenceImages', 'updatedAt']
          ) &&
          request.auth.uid == resource.data.homeownerUid &&
          resource.data.status == 'pending' &&
          resource.data.pendingInvitationUid == null
        ) ||
        // Homeowner: invite a contractor.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['pendingInvitationUid', 'pendingInvitationName', 'pendingInvitationUsername', 'updatedAt']
          ) &&
          request.auth.uid == resource.data.homeownerUid
        ) ||
        // Homeowner: verify a progress photo, or mark the project complete.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastVerifiedPhotoUrl', 'status', 'review', 'updatedAt']
          ) &&
          request.auth.uid == resource.data.homeownerUid
        ) ||
        // Invited professional: accept (sets contractor, clears invite) or decline (just clears invite).
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['contractorUid', 'contractorName', 'contractorUsername', 'pendingInvitationUid', 'pendingInvitationName', 'pendingInvitationUsername', 'status', 'updatedAt']
          ) &&
          request.auth.uid == resource.data.pendingInvitationUid
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['pendingInvitationUid', 'pendingInvitationName', 'pendingInvitationUsername', 'updatedAt']
          ) &&
          request.auth.uid == resource.data.pendingInvitationUid
        )
      );
      // Homeowner-only, and only in the same window that governs editing —
      // never after an invite goes out, and never once a contractor is set.
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.homeownerUid &&
        resource.data.status == 'pending' &&
        resource.data.pendingInvitationUid == null &&
        resource.data.contractorUid == null;

      match /tasks/{taskId} {
        allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'completed' || (
          request.auth != null && (
            request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
            request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
          )
        );
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid;
        allow update: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
        );
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid &&
          resource.data.hasProgress == false;
      }

      match /updates/{updateId} {
        allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'completed' || (
          request.auth != null && (
            request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
            request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
          )
        );
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid;
        allow update: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid;
        allow delete: if false;
      }

      // Homeowner contact info, shared only with the accepted contractor on this
      // specific project. Deliberately excluded from the "completed = public" read
      // rule above — this never becomes public, even after the project finishes.
      match /private/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.contractorUid
        );
        allow create, update: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid;
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.homeownerUid;
      }
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.recipientUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }
  }
}