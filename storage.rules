rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|heic|heif)');
    }

    match /portfolio/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|heic|heif)');
    }

    match /progress/{projectId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == firestore.get(/databases/(default)/documents/projects/$(projectId)).data.contractorUid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|heic|heif)');
    }

    match /projects/{projectId}/reference/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == firestore.get(/databases/(default)/documents/projects/$(projectId)).data.homeownerUid
                   && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.status == 'pending'
                   && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.pendingInvitationUid == null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|heic|heif)');
    }
  }
}